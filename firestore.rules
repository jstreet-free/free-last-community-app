rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function hasEmail(emailStr) {
      return isSignedIn() && 
        request.auth.token != null && 
        'email' in request.auth.token && 
        request.auth.token.email != null && 
        request.auth.token.email.lower() == emailStr;
    }

    function isAdmin() { 
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        hasEmail('jstreet@freeatlast.st') ||
        hasEmail('jstreet@freeatlast.co.uk') ||
        hasEmail('info@freeatlast.co.uk')
      );
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isOwnerEmail() {
      return isSignedIn() && (
        hasEmail('jstreet@freeatlast.st') ||
        hasEmail('jstreet@freeatlast.co.uk') ||
        hasEmail('info@freeatlast.co.uk')
      );
    }

    // --- Validation Helpers ---
    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'content', 'date', 'author', 'category'])
        && data.title is string && data.title.size() <= 200
        && data.content is string && data.content.size() <= 5000
        && data.date is string
        && data.author is string
        && data.category is string;
    }

    function isValidActivity(data) {
      return data.keys().hasAll(['title', 'description', 'date', 'time', 'location', 'capacity', 'bookedCount', 'category', 'status'])
        && data.title is string && data.title.size() <= 200
        && data.description is string && data.description.size() <= 2000
        && data.date is string
        && data.time is string
        && data.location is string
        && data.capacity is number
        && data.bookedCount is number
        && data.category in ['youth', 'community', 'sports', 'education']
        && data.status in ['upcoming', 'past'];
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'mobile', 'message', 'type', 'timestamp', 'status', 'targetEmail'])
        && data.name is string && data.name.size() <= 200
        && data.email is string && data.email.size() <= 200
        && data.mobile is string 
        && data.message is string && data.message.size() <= 10000
        && data.type is string
        && data.status is string
        && data.targetEmail is string
        && data.timestamp is timestamp;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['bookerName', 'participantName', 'bookerMobile', 'sessionId', 'userId', 'bookingDate', 'sessionTitle', 'sessionDate', 'sessionTime', 'targetEmail'])
        && data.bookerName is string
        && data.participantName is string
        && data.sessionId is string
        && data.userId == request.auth.uid;
    }

    function isValidTeamLog(data) {
      return data.keys().hasAll(['teamMemberId', 'teamMemberName', 'sessionName', 'category', 'hours', 'date', 'description', 'attendeesCount', 'outcome', 'timestamp'])
        && data.teamMemberId == request.auth.uid
        && data.sessionName is string
        && data.hours is number
        && data.timestamp is timestamp;
    }
    
    function isValidWellbeingLog(data) {
      return data.keys().hasAll(['memberId', 'memberName', 'date', 'emotion', 'impactText'])
        && data.memberId == request.auth.uid
        && data.memberName is string
        && data.date is string
        && data.emotion is string
        && data.impactText is string;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'status', 'id', 'name', 'profileComplete'])
        && data.email is string && data.email.size() <= 100
        && data.role in ['admin', 'team', 'member', 'friend']
        && data.status in ['pending', 'approved', 'rejected']
        && data.id is string
        && data.name is string
        && data.profileComplete is bool;
    }

    function isValidCaseStudyRequest(data) {
      return data.keys().hasAll(['title', 'prompt', 'date', 'isActive', 'creatorId'])
        && data.title is string && data.title.size() <= 200
        && data.prompt is string && data.prompt.size() <= 2000
        && data.date is string
        && data.isActive is bool
        && data.creatorId == request.auth.uid;
    }

    function isValidCaseStudy(data) {
      return data.keys().hasAll(['requestId', 'requestTitle', 'memberId', 'memberName', 'memberEmail', 'content', 'date', 'status'])
        && data.requestId is string
        && data.requestTitle is string
        && data.memberId == request.auth.uid
        && data.memberName is string
        && data.memberEmail is string
        && data.content is string && data.content.size() <= 10000
        && data.date is string
        && data.status in ['approved', 'pending'];
    }

    function isValidNewsletterSubscriber(data) {
      return data.keys().hasAll(['name', 'email', 'subscribedAt'])
        && data.name is string && data.name.size() <= 200
        && data.email is string && data.email.size() <= 200;
    }

    function isValidNewsletter(data) {
      return data.keys().hasAll(['title', 'content', 'sentAt', 'recipientCount'])
        && data.title is string && data.title.size() <= 250
        && data.content is string && data.content.size() <= 50000
        && data.recipientCount is number;
    }

    function isValidFriendNeed(data) {
      return data.keys().hasAll(['title', 'description', 'category', 'date', 'sentStatus'])
        && data.title is string && data.title.size() <= 200
        && data.description is string && data.description.size() <= 5000
        && data.category in ['volunteers', 'resources', 'finance', 'events', 'sponsorship']
        && data.date is string
        && data.sentStatus in ['draft', 'sent'];
    }

    function isValidFriendOffer(data) {
      return data.keys().hasAll(['friendName', 'friendEmail', 'friendMobile', 'category', 'description', 'date', 'status'])
        && data.friendName is string && data.friendName.size() <= 200
        && data.friendEmail is string && data.friendEmail.size() <= 200
        && data.friendMobile is string
        && data.category is string
        && data.description is string && data.description.size() <= 5000
        && data.date is string
        && data.status in ['pending', 'approved', 'rejected'];
    }

    function isValidYouTubeVideo(data) {
      return data.keys().hasAll(['title', 'url', 'addedAt'])
        && data.title is string && data.title.size() <= 300
        && data.url is string && data.url.size() <= 500
        && data.addedAt is string;
    }

    // --- Match Rules ---

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin() && isValidAnnouncement(incoming());
    }

    match /activities/{activityId} {
      allow read: if true;
      allow write: if isAdmin() && isValidActivity(incoming());
    }

    match /assets/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /partners/{partnerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /impact_stories/{storyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow create: if isValidInquiry(incoming());
      allow read, delete, update: if isAdmin();
    }

    match /mail/{mailId} {
      allow create: if true; 
      allow read, update, delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow create: if isSignedIn() && isValidBooking(incoming());
      allow read: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow delete, update: if isAdmin();
    }

    match /users/{userId} {
      // PII Protection: only owner or admin can read details
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isOwner(userId) && isValidUser(incoming()) 
                   && (
                     ((incoming().role == 'member' || incoming().role == 'team') && incoming().status == 'pending')
                     || (incoming().role == 'friend' && incoming().status == 'approved')
                     || (isOwnerEmail() && incoming().role == 'admin' && incoming().status == 'approved')
                   );
      allow update: if (isOwner(userId) && (
                     incoming().diff(existing()).affectedKeys().hasOnly(['name', 'department', 'profileComplete', 'profile', 'status', 'photoPolicyAgreed', 'photoPolicyAgreedAt'])
                     && (
                       // Team/Members can update status but team can't approve themselves
                       (incoming().status == 'pending' || (existing().role == 'member' && incoming().status == 'approved'))
                       || isOwnerEmail()
                     )
                     || (isOwnerEmail() && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status', 'profileComplete']))
                   ))
                   || (isAdmin() && isValidUser(incoming()));
      allow delete: if isAdmin();
    }

    match /team_logs/{logId} {
      allow create: if isSignedIn() && isValidTeamLog(incoming());
      allow read: if isSignedIn() && (resource.data.teamMemberId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /wellbeing_logs/{logId} {
      allow create: if isSignedIn() && isValidWellbeingLog(incoming());
      allow read: if isSignedIn() && (resource.data.memberId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /gallery_albums/{albumId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /case_study_requests/{requestId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidCaseStudyRequest(incoming());
    }

    match /case_studies/{studyId} {
      allow create: if isSignedIn() && isValidCaseStudy(incoming());
      allow read: if isSignedIn() && (resource.data.memberId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /newsletter_subscribers/{subscriberId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /newsletters/{newsletterId} {
      allow read: if true;
      allow create: if isAdmin() && isValidNewsletter(incoming());
      allow update, delete: if isAdmin();
    }

    match /friend_needs/{needId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidFriendNeed(incoming());
      allow delete: if isAdmin();
    }

    match /friend_offers/{offerId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /youtube_videos/{videoId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidYouTubeVideo(incoming());
      allow delete: if isAdmin();
    }
  }
}
