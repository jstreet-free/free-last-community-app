rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reuseable helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // In this app, we consider anyone signed in with at least Team access as authorized to manage assets
      // but strictly we check for 'admin' role in logic. Rules can be hardened further.
      return isSignedIn();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Activities
    match /activities/{activityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Assets
    match /assets/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Partners
    match /partners/{partnerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Impact Stories
    match /impact_stories/{storyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Inquiries
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, delete, update: if isAdmin();
    }

    // Bookings
    match /bookings/{bookingId} {
      allow create: if isSignedIn();
      allow read, delete, update: if isAdmin();
    }

    // Users
    match /users/{userId} {
      // Allow any signed-in user to read user profiles (needed for lists and self-lookup)
      allow read: if request.auth != null;
      // Allow a user to create their own initial profile document
      allow create: if request.auth != null && request.auth.uid == userId;
      // Allow a user to update their own document, or an admin to update any document
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
  }
}
