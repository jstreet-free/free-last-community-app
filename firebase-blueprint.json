{
  "entities": {
    "announcement": {
      "title": "Announcement",
      "description": "A news update or announcement for the centre.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "author": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["title", "content", "date", "author", "category"]
    },
    "activity": {
      "title": "Activity",
      "description": "A session or activity scheduled at the centre.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "capacity": { "type": "number" },
        "bookedCount": { "type": "number" },
        "category": { "type": "string", "enum": ["youth", "community", "sports", "education"] },
        "flickrAlbumUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["upcoming", "upcoming_bookable", "upcoming_not_bookable", "past"] },
        "imageUrl": { "type": "string" },
        "includesFood": { "type": "boolean" },
        "foodOptions": { "type": "string" }
      },
      "required": ["title", "description", "date", "time", "location", "capacity", "bookedCount", "category", "status"]
    },
    "asset": {
      "title": "Asset",
      "description": "A brand image or UI asset.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "value": { "type": "string" }
      },
      "required": ["value"]
    },
    "partner": {
      "title": "Partner",
      "description": "A trusted partner organization.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "logo": { "type": "string" },
        "description": { "type": "string" },
        "details": { "type": "string" },
        "website": { "type": "string" },
        "order": { "type": "number", "description": "Display order index on the partner page" },
        "stats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        }
      },
      "required": ["name", "logo", "description"]
    },
    "impactStory": {
      "title": "Impact Story",
      "description": "A news update or story about a partnership.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "partnerName": { "type": "string" },
        "image": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["title", "content", "partnerName"]
    },
    "inquiry": {
      "title": "Inquiry",
      "description": "A contact inquiry or member question.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "mobile": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "targetEmail": { "type": "string" },
        "timestamp": { "type": "string", "description": "Server timestamp" },
        "status": { "type": "string", "enum": ["new", "read", "contacted", "replied"] },
        "userId": { "type": "string" },
        "reply": { "type": "string" },
        "repliedAt": { "type": "string" },
        "repliedBy": { "type": "string" },
        "replies": { "type": "array" }
      },
      "required": ["name", "email", "mobile", "message"]
    },
    "mail": {
      "title": "Email Trigger",
      "description": "A document that triggers an email via the Firebase Trigger Email extension.",
      "type": "object",
      "properties": {
        "to": { "type": "array", "items": { "type": "string" } },
        "message": {
          "type": "object",
          "properties": {
            "subject": { "type": "string" },
            "text": { "type": "string" },
            "html": { "type": "string" }
          }
        }
      }
    },
    "booking": {
      "title": "Booking",
      "description": "A registration record for an activity session.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookerName": { "type": "string" },
        "participantName": { "type": "string" },
        "bookerMobile": { "type": "string" },
        "bookingDate": { "type": "string", "description": "Server timestamp" },
        "sessionTitle": { "type": "string" },
        "sessionDate": { "type": "string" },
        "sessionTime": { "type": "string" },
        "sessionId": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["booked", "cancelled"] },
        "attended": { "type": "boolean" },
        "foodChoice": { "type": "string" },
        "foodConflictConfirmed": { "type": "boolean" },
        "foodConflictWarningRaised": { "type": "boolean" }
      },
      "required": ["bookerName", "participantName", "bookerMobile", "sessionId"]
    },
    "user": {
      "title": "User",
      "description": "A system user (admin, team, or member) with approval status.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "team", "member"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "department": { "type": "string" },
        "profileComplete": { "type": "boolean" }
      },
      "required": ["email", "role", "status"]
    },
    "galleryAlbum": {
      "title": "Gallery Album",
      "description": "An archived photography collection linked to Flickr.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "category": { "type": "string", "enum": ["youth", "community", "sports", "education"] },
        "flickrAlbumUrl": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["title", "description", "date", "category", "flickrAlbumUrl"]
    },
    "wellbeingLog": {
      "title": "Wellbeing Log",
      "description": "A reflection or mood entry from a team member or member.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "emotion": { "type": "string" },
        "impactText": { "type": "string" },
        "aiResponse": { "type": "string" },
        "isUrgent": { "type": "boolean" }
      },
      "required": ["memberId", "memberName", "date", "emotion", "impactText"]
    },
    "caseStudyRequest": {
      "title": "Case Study Request",
      "description": "An ad-hoc or monthly call for case studies and impact feed back.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "prompt": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "isActive": { "type": "boolean" },
        "creatorId": { "type": "string" }
      },
      "required": ["title", "prompt", "date", "isActive", "creatorId"]
    },
    "caseStudy": {
      "title": "Case Study",
      "description": "A success story or case study submitted by a member in response to a request.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requestId": { "type": "string" },
        "requestTitle": { "type": "string" },
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "memberEmail": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["approved", "pending"] },
        "category": { "type": "string" },
        "aiSummary": { "type": "string" },
        "sentimentScore": { "type": "number" }
      },
      "required": ["requestId", "requestTitle", "memberId", "memberName", "memberEmail", "content", "date", "status"]
    },
    "newsletterSubscriber": {
      "title": "Newsletter Subscriber",
      "description": "A subscriber to the monthly newsletter.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subscribedAt": { "type": "string", "description": "Server timestamp" }
      },
      "required": ["name", "email"]
    },
    "newsletter": {
      "title": "Newsletter",
      "description": "An on-brand monthly newsletter.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "videoUrl": { "type": "string" },
        "links": { "type": "array" },
        "sentAt": { "type": "string", "description": "Server timestamp" },
        "recipientCount": { "type": "number" }
      },
      "required": ["title", "content", "sentAt", "recipientCount"]
    },
    "friendNeed": {
      "title": "Friend Need",
      "description": "A help request added by admin for friends to see.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["volunteers", "resources", "finance", "events", "sponsorship"] },
        "date": { "type": "string" },
        "sentStatus": { "type": "string", "enum": ["draft", "sent"] },
        "sentAt": { "type": "string", "description": "Server timestamp" }
      },
      "required": ["title", "description", "category", "date", "sentStatus"]
    },
    "friendOffer": {
      "title": "Friend Offer",
      "description": "A volunteer or material offer sent by a friend.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "friendName": { "type": "string" },
        "friendEmail": { "type": "string" },
        "friendMobile": { "type": "string" },
        "businessName": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] }
      },
      "required": ["friendName", "friendEmail", "friendMobile", "category", "description", "date", "status"]
    },
    "youtubeVideo": {
      "title": "YouTube Video",
      "description": "A YouTube channel video link managed by administrators.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "description": { "type": "string" },
        "addedAt": { "type": "string" }
      },
      "required": ["title", "url", "addedAt"]
    },
    "warning": {
      "title": "Admin Warning",
      "description": "A system warning or alert triggered by member registrations or food allergies.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["member_registration_blocked", "food_allergy_conflict"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "personName": { "type": "string" },
        "userEmail": { "type": "string" },
        "details": { "type": "object" },
        "timestamp": { "type": "string" }
      },
      "required": ["type", "title", "message", "personName", "userEmail", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "Collection of system users and their approval status."
    },
    "/announcements/{announcementId}": {
      "schema": "announcement",
      "description": "Collection of centre updates."
    },
    "/activities/{activityId}": {
      "schema": "activity",
      "description": "Collection of session activities."
    },
    "/assets/{assetId}": {
      "schema": "asset",
      "description": "Collection of brand images and assets."
    },
    "/partners/{partnerId}": {
      "schema": "partner",
      "description": "Collection of trusted partners."
    },
    "/impact_stories/{storyId}": {
      "schema": "impactStory",
      "description": "Collection of partner impact stories."
    },
    "/inquiries/{inquiryId}": {
      "schema": "inquiry",
      "description": "Collection of user inquiries."
    },
    "/mail/{mailId}": {
      "schema": "mail",
      "description": "Collection for triggering outgoing emails."
    },
    "/bookings/{bookingId}": {
      "schema": "booking",
      "description": "Collection of activity bookings."
    },
    "/gallery_albums/{albumId}": {
      "schema": "galleryAlbum",
      "description": "Collection of archived photo collections."
    },
    "/wellbeing_logs/{logId}": {
      "schema": "wellbeingLog",
      "description": "Collection of wellbeing and mood logs."
    },
    "/case_study_requests/{requestId}": {
      "schema": "caseStudyRequest",
      "description": "Collection of calls for case studies launched by administrators."
    },
    "/case_studies/{studyId}": {
      "schema": "caseStudy",
      "description": "Collection of member-submitted case studies representing social impact."
    },
    "/newsletter_subscribers/{subscriberId}": {
      "schema": "newsletterSubscriber",
      "description": "Collection of newsletter email subscribers."
    },
    "/newsletters/{newsletterId}": {
      "schema": "newsletter",
      "description": "Collection of sent/saved newsletters."
    },
    "/friend_needs/{needId}": {
      "schema": "friendNeed",
      "description": "Collection of material, volunteer, or event needs requested by administrators."
    },
    "/friend_offers/{offerId}": {
      "schema": "friendOffer",
      "description": "Collection of contribution, equipment, or volunteering offers made by friends."
    },
    "/youtube_videos/{videoId}": {
      "schema": "youtubeVideo",
      "description": "Collection of YouTube link highlights for the media center."
    },
    "/warnings/{warningId}": {
      "schema": "warning",
      "description": "Collection of system warnings and member alerts."
    }
  }
}
